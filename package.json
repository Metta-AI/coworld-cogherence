{
  "name": "cogherence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run play -- --seed 7 --cogs 4 --out public/replay.json",
    "dev": "vite",
    "prebuild": "npm run play -- --seed 7 --cogs 4 --out public/replay.json",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/cli-serve.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/cli-serve.js",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "playwright test",
    "play": "tsx src/cli.ts",
    "dev:llm": "AWS_REGION=${AWS_REGION:-us-west-2} tsx src/cli-llm.ts",
    "serve": "tsx watch --clear-screen=false --ignore 'vite.config.ts.timestamp-*' src/cli-serve.ts",
    "serve:llm": "AWS_REGION=${AWS_REGION:-us-west-2} tsx watch --clear-screen=false --ignore 'vite.config.ts.timestamp-*' src/cli-serve.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3",
    "express": "^4.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@playwright/test": "^1.45",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/express": "^4.17",
    "@types/node": "^20",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@types/ws": "^8.5",
    "@vitejs/plugin-react": "^4.3",
    "esbuild": "^0.28.1",
    "jsdom": "^24",
    "tsx": "^4",
    "typescript": "^5.4",
    "vite": "^5.4",
    "vitest": "^1.6"
  }
}
